	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">l0PCjQZpx2GnWfDn2U+gRazubTk1hz1nPFvOovIG0cM</hasSha256sum>
