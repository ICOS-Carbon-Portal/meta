	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">gVrbpWJftnFthEBpr1mYJhj0rj3nz1VVOn0YvNiaVzo</hasSha256sum>
