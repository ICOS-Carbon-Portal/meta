	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_H_Aviation_IiWMA5E7Cz30K-NFQ3UrlCjO"/>
	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_I_Off-road_IiWMA5E7Cz30K-NFQ3UrlCjO"/>
