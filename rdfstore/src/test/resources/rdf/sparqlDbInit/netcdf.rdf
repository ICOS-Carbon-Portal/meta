	<rdf:type rdf:resource="http://meta.icos-cp.eu/ontologies/cpmeta/DataObject"/>
	<hasEndTime xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-01-01T00:00:00Z</hasEndTime>
