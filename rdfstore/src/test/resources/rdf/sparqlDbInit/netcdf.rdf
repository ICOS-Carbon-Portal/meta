	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">2NV6g2b/l0pqQJ1+kNBJXIt3EZuxu/a8zi0qZlhFi0A</hasSha256sum>
