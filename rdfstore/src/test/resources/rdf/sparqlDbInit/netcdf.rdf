	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_H_Aviation_zNQn0Z-PNSHgWVvSyClisEcM"/>
	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_I_Off-road_zNQn0Z-PNSHgWVvSyClisEcM"/>
