<rdf:Description rdf:about="https://meta.icos-cp.eu/objects/KOT9Wfn10FH1FJOOgOu0aJm0">
	<rdf:type rdf:resource="http://meta.icos-cp.eu/ontologies/cpmeta/DataObject"/>
	<hasEndTime xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-31T00:00:00Z</hasEndTime>
	<hasName xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/">co2flux_monthly_carboscope_core_2009_2018.nc</hasName>
