	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_H_Aviation_ihGYzRI5Rx_ZW0mITcPhLtef"/>
	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_I_Off-road_ihGYzRI5Rx_ZW0mITcPhLtef"/>
