	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_focn_KOT9Wfn10FH1FJOOgOu0aJm0"/>
</rdf:Description>

