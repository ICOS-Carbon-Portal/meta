	<hasSpatialCoverage xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/spcov_D_v0gdeP4LUkkkBDf3L8GfaZ"/>
	<hasStartTime xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-01-01T00:00:00Z</hasStartTime>
	<description xmlns="http://purl.org/dc/terms/">This data set is a product obtained from the Carbon Cycle Data Assimilation System (CCDAS) within the SMOS+VEG study (http://smos-veg.inversion-lab.com), funded by the European Space Agency through its Support to Science Element. It provides monthly global Net Ecosystem Productivity (NEP) maps at 0.25 degree resolution for the period 2010-2015 as simulated by the terrestrial biosphere model BETHY after assimilation of SMOS Soil Moisture, SMOS Vegetation Optical Depth, and atmospheric CO2 observations and includes per-pixel uncertainty ranges derived through error propagation consistent with the observational uncertainties.</description>
	<title xmlns="http://purl.org/dc/terms/">BETHY global Net Ecosystem Production (NEP) maps at 0.25 degree resolution for the period 2010-2015</title>
	<hasDoi xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/">10.18160/YD1G-4TRQ</hasDoi>
	<hasTemporalResolution xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/">monthly</hasTemporalResolution>
</rdf:Description>

