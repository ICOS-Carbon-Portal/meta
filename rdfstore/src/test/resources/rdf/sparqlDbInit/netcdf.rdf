<rdf:Description rdf:about="https://meta.icos-cp.eu/objects/eQR8He06MCk0qvqYvuNBKLgD">
	<rdf:type rdf:resource="http://meta.icos-cp.eu/ontologies/cpmeta/DataObject"/>
	<hasEndTime xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-31T00:00:00Z</hasEndTime>
	<hasName xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/">co2flux_monthly_carboscope_all_2009_2018.nc</hasName>
	<hasObjectSpec xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/cpmeta/inversionModelingSpatial"/>
	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">eQR8He06MCk0qvqYvuNBKLgDASDoAG7wPFDlkFD/pb4</hasSha256sum>
