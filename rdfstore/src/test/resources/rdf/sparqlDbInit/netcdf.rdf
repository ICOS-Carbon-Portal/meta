	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_cement_jUzNwi_8dh9dGqW1Vt-BtY4d"/>
