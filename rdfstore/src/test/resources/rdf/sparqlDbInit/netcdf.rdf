<rdf:Description rdf:about="https://meta.icos-cp.eu/objects/a-TvtFmBZLYyELn_kU1kFHxe">
	<rdf:type rdf:resource="http://meta.icos-cp.eu/ontologies/cpmeta/DataObject"/>
	<hasEndTime xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-02-28T23:00:00Z</hasEndTime>
	<hasName xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/">anthropogenic.202202.nc</hasName>
	<hasObjectSpec xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/cpmeta/anthropogenicEmissionModelResults"/>
	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">a+TvtFmBZLYyELn/kU1kFHxeTM89VZKHWkWVaJoMCxs</hasSha256sum>
	<hasSizeInBytes xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#long">524268633</hasSizeInBytes>
