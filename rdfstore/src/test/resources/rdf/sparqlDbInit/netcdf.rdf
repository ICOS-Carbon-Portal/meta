	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_combustion_zNQn0Z-PNSHgWVvSyClisEcM"/>
