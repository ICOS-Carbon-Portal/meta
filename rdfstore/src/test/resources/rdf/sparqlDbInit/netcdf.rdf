	<hasKeywords xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/">carbon flux</hasKeywords>
	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_combustion_6UOOiDzOQ1t-XvW1D9ioCcjV"/>
