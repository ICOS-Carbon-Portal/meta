	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">esG+8tv3x0Z6SBC25yv6y/ymuh0fKdUa2N93URnnIH0</hasSha256sum>
