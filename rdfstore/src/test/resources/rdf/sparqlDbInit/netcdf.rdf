	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_combustion_ihGYzRI5Rx_ZW0mITcPhLtef"/>
