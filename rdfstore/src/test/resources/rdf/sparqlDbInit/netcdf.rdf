	<hasActualVariable xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:resource="http://meta.icos-cp.eu/resources/varinfo_H_Aviation_-3lbqZ36FH3m2QmbHx90oDKb"/>
