	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">b9cRKGVrNhMyErqhgqZkCHSfZrO0HrI8CoRf7kf2da0</hasSha256sum>
