	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">Z2SbrVqgQfscnnNAmwjK/M/oBPPKGtNEy/q0zSBmXgA</hasSha256sum>
