	<hasSha256sum xmlns="http://meta.icos-cp.eu/ontologies/cpmeta/" rdf:datatype="http://www.w3.org/2001/XMLSchema#base64Binary">h3DBamwfD48ucZZVBME/SsoguDx9RZl2K2YqgklDxnU</hasSha256sum>
