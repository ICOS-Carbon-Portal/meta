@prefix cpmeta: <http://meta.icos-cp.eu/ontologies/cpmeta/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix stentry:<http://meta.icos-cp.eu/ontologies/stationentry/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://meta.icos-cp.eu/resources/cpmeta/> {
	<http://meta.icos-cp.eu/resources/projects/icos>
		rdfs:label "ICOS" .

	<http://meta.icos-cp.eu/resources/themes/atmosphere>
		rdfs:label "Atmosphere" ;
		cpmeta:hasIcon "https://static.icos-cp.eu/atmosphere.svg"^^xsd:anyURI .

	cpmeta:csvWithIso8601tsFirstCol
		rdfs:label "ASCII CSV time series" .

	cpmeta:asciiEncoding
		rdfs:label "plain text" .

	<http://meta.icos-cp.eu/resources/roles/PI>
		a cpmeta:Role ;
		rdfs:label "PI" .

	<http://meta.icos-cp.eu/resources/organizations/CP>
		a cpmeta:Organization ;
		rdfs:label "CP" ;
		cpmeta:hasName "Carbon Portal" .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeries>
		a cpmeta:DataObjectSpec ;
		rdfs:label "Test time series" ;
		cpmeta:hasAssociatedProject <http://meta.icos-cp.eu/resources/projects/icos> ;
		cpmeta:hasDataTheme <http://meta.icos-cp.eu/resources/themes/atmosphere> ;
		cpmeta:hasFormat cpmeta:csvWithIso8601tsFirstCol ;
		cpmeta:hasEncoding cpmeta:asciiEncoding ;
		cpmeta:hasSpecificDatasetType cpmeta:stationTimeSeriesDataset ;
		cpmeta:containsDataset <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset> ;
		cpmeta:hasDataLevel "2"^^xsd:integer .

	#the dataset columns are what the "Previewable variables" table on data object landing pages is made of
	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset>
		a cpmeta:TabularDatasetSpec ;
		rdfs:label "Test time series dataset" ;
		cpmeta:hasColumn <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_TIMESTAMP> ;
		cpmeta:hasColumn <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_co2> ;
		cpmeta:hasColumn <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_ch4> .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_TIMESTAMP>
		a cpmeta:DatasetColumn ;
		rdfs:label "Timestamp column" ;
		cpmeta:hasColumnTitle "TIMESTAMP" ;
		cpmeta:hasValueType <http://meta.icos-cp.eu/resources/cpmeta/timestamp> .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_co2>
		a cpmeta:DatasetColumn ;
		rdfs:label "CO2 column" ;
		cpmeta:hasColumnTitle "co2" ;
		cpmeta:hasValueType <http://meta.icos-cp.eu/resources/cpmeta/co2MixingRatio> .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_ch4>
		a cpmeta:DatasetColumn ;
		rdfs:label "CH4 column" ;
		cpmeta:hasColumnTitle "ch4" ;
		cpmeta:hasValueType <http://meta.icos-cp.eu/resources/cpmeta/ch4MixingRatio> .

	#no quantity kind or unit, so no preview link
	<http://meta.icos-cp.eu/resources/cpmeta/timestamp>
		a cpmeta:ValueType ;
		rdfs:label "time instant, UTC" .

	<http://meta.icos-cp.eu/resources/cpmeta/co2MixingRatio>
		a cpmeta:ValueType ;
		rdfs:label "CO2 mixing ratio (dry mole fraction)" ;
		cpmeta:hasQuantityKind <http://meta.icos-cp.eu/resources/cpmeta/portion> ;
		cpmeta:hasUnit "µmol mol-1" .

	<http://meta.icos-cp.eu/resources/cpmeta/ch4MixingRatio>
		a cpmeta:ValueType ;
		rdfs:label "CH4 mixing ratio (dry mole fraction)" ;
		cpmeta:hasQuantityKind <http://meta.icos-cp.eu/resources/cpmeta/portion> ;
		cpmeta:hasUnit "nmol mol-1" .

	<http://meta.icos-cp.eu/resources/cpmeta/portion>
		a cpmeta:QuantityKind ;
		rdfs:label "portion" .
}

<http://meta.icos-cp.eu/resources/icos/> {
	<http://meta.icos-cp.eu/resources/stations/TST>
		a cpmeta:AS ;
		rdfs:label "TST" ;
		cpmeta:hasName "Test station" ;
		cpmeta:hasStationId "TST" ;
		cpmeta:hasLatitude "56.1"^^xsd:double ;
		cpmeta:hasLongitude "13.4"^^xsd:double ;
		cpmeta:hasElevation "150.0"^^xsd:float ;
		cpmeta:countryCode "SE" .

	<http://meta.icos-cp.eu/resources/organizations/ATC>
		a cpmeta:ThematicCenter ;
		rdfs:label "ATC" ;
		cpmeta:hasName "Atmosphere Thematic Centre" ;
		cpmeta:hasDataTheme <http://meta.icos-cp.eu/resources/themes/atmosphere> .

	<http://meta.icos-cp.eu/resources/people/Test_Person>
		a cpmeta:Person ;
		rdfs:label "Test Person" ;
		cpmeta:hasFirstName "Test" ;
		cpmeta:hasLastName "Person" ;
		cpmeta:hasMembership <http://meta.icos-cp.eu/resources/memberships/TST_PI_Person> .

	<http://meta.icos-cp.eu/resources/people/Zed_Contributor>
		a cpmeta:Person ;
		rdfs:label "Zed Contributor" ;
		cpmeta:hasFirstName "Zed" ;
		cpmeta:hasLastName "Contributor" .

	<http://meta.icos-cp.eu/resources/memberships/TST_PI_Person>
		a cpmeta:Membership ;
		cpmeta:atOrganization <http://meta.icos-cp.eu/resources/stations/TST> ;
		cpmeta:hasRole <http://meta.icos-cp.eu/resources/roles/PI> ;
		cpmeta:hasStartTime "2021-01-01T00:00:00Z"^^xsd:dateTime .

	<http://meta.icos-cp.eu/resources/instruments/TST_1>
		a cpmeta:Instrument ;
		cpmeta:hasName "Test instrument" ;
		cpmeta:hasModel "Picarro G2401" ;
		cpmeta:hasSerialNumber "SN-1" ;
		cpmeta:hasInstrumentOwner <http://meta.icos-cp.eu/resources/organizations/CP> ;
		ssn:hasDeployment <http://meta.icos-cp.eu/resources/deployments/TST_1_co2> ;
		ssn:hasDeployment <http://meta.icos-cp.eu/resources/deployments/TST_1_co2_old> .

	#overlaps the acquisition interval of the test data object, so shown for its co2 column
	<http://meta.icos-cp.eu/resources/deployments/TST_1_co2>
		a ssn:Deployment ;
		cpmeta:atOrganization <http://meta.icos-cp.eu/resources/stations/TST> ;
		cpmeta:hasVariableName "co2" ;
		ssn:forProperty <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_co2> ;
		cpmeta:hasStartTime "2020-06-01T00:00:00Z"^^xsd:dateTime ;
		cpmeta:hasLatitude "56.1"^^xsd:double ;
		cpmeta:hasLongitude "13.4"^^xsd:double ;
		cpmeta:hasSamplingHeight "50.0"^^xsd:float .

	#ended before the acquisition interval started, so not shown
	<http://meta.icos-cp.eu/resources/deployments/TST_1_co2_old>
		a ssn:Deployment ;
		cpmeta:atOrganization <http://meta.icos-cp.eu/resources/stations/TST> ;
		cpmeta:hasVariableName "co2" ;
		ssn:forProperty <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_co2> ;
		cpmeta:hasStartTime "2018-01-01T00:00:00Z"^^xsd:dateTime ;
		cpmeta:hasEndTime "2019-01-01T00:00:00Z"^^xsd:dateTime .
}

#the labeling app links its station entries to the production stations by a plain xsd:anyURI
#literal, which is where the labeling date of an ICOS station comes from
<http://meta.icos-cp.eu/resources/stationlabeling/> {
	<http://meta.icos-cp.eu/resources/stationentry/AS_TST>
		stentry:hasProductionCounterpart "http://meta.icos-cp.eu/resources/stations/TST"^^xsd:anyURI ;
		stentry:hasApplicationStatus "STEP3APPROVED" ;
		stentry:hasAppStatusDate "2019-06-01T12:00:00Z"^^xsd:dateTime .
}

