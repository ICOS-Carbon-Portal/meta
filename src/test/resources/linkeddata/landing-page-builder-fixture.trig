		cpmeta:hasFormat cpmeta:csvWithIso8601tsFirstCol ;
		cpmeta:hasEncoding cpmeta:asciiEncoding ;
		cpmeta:hasSpecificDatasetType cpmeta:stationTimeSeriesDataset ;
		cpmeta:hasDataLevel "2"^^xsd:integer .
}

