		rdfs:label "plain text" .

	<http://meta.icos-cp.eu/resources/climateZones/Dfc>
		rdfs:label "Dfc - Subarctic" .

	<http://meta.icos-cp.eu/resources/ecosystems/ENF>
		rdfs:label "ENF - Evergreen Needleleaf Forests" .

	<http://meta.icos-cp.eu/resources/roles/PI>
		a cpmeta:Role ;
		rdfs:label "PI" .

	<http://meta.icos-cp.eu/resources/organizations/CP>
		a cpmeta:Organization ;
		rdfs:label "CP" ;
		cpmeta:hasName "Carbon Portal" .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeries>
		a cpmeta:DataObjectSpec ;
		rdfs:label "Test time series" ;
		cpmeta:hasAssociatedProject <http://meta.icos-cp.eu/resources/projects/icos> ;
		cpmeta:hasDataTheme <http://meta.icos-cp.eu/resources/themes/atmosphere> ;
		cpmeta:hasFormat cpmeta:csvWithIso8601tsFirstCol ;
		cpmeta:hasEncoding cpmeta:asciiEncoding ;
		cpmeta:hasSpecificDatasetType cpmeta:stationTimeSeriesDataset ;
		cpmeta:containsDataset <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset> ;
		cpmeta:hasDocumentationObject <https://meta.icos-cp.eu/objects/ERERERERERERERERERERERER> ;
		cpmeta:hasDataLevel "2"^^xsd:integer .

	#the dataset columns are what the "Previewable variables" table on data object landing pages is made of
	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset>
		a cpmeta:TabularDatasetSpec ;
		rdfs:label "Test time series dataset" ;
		cpmeta:hasColumn <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_TIMESTAMP> ;
		cpmeta:hasColumn <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_co2> ;
		cpmeta:hasColumn <http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_ch4> .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_TIMESTAMP>
		a cpmeta:DatasetColumn ;
		rdfs:label "Timestamp column" ;
		cpmeta:hasColumnTitle "TIMESTAMP" ;
		cpmeta:hasValueType <http://meta.icos-cp.eu/resources/cpmeta/timestamp> .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_co2>
		a cpmeta:DatasetColumn ;
		rdfs:label "CO2 column" ;
		cpmeta:hasColumnTitle "co2" ;
		cpmeta:hasValueType <http://meta.icos-cp.eu/resources/cpmeta/co2MixingRatio> .

	<http://meta.icos-cp.eu/resources/cpmeta/testTimeSeriesDataset_ch4>
		a cpmeta:DatasetColumn ;
		rdfs:label "CH4 column" ;
		cpmeta:hasColumnTitle "ch4" ;
		cpmeta:hasValueType <http://meta.icos-cp.eu/resources/cpmeta/ch4MixingRatio> .

	#no quantity kind or unit, so no preview link
	<http://meta.icos-cp.eu/resources/cpmeta/timestamp>
		a cpmeta:ValueType ;
		rdfs:label "time instant, UTC" .

	<http://meta.icos-cp.eu/resources/cpmeta/co2MixingRatio>
		a cpmeta:ValueType ;
		rdfs:label "CO2 mixing ratio (dry mole fraction)" ;
		cpmeta:hasQuantityKind <http://meta.icos-cp.eu/resources/cpmeta/portion> ;
		cpmeta:hasUnit "µmol mol-1" .

	<http://meta.icos-cp.eu/resources/cpmeta/ch4MixingRatio>
		a cpmeta:ValueType ;
		rdfs:label "CH4 mixing ratio (dry mole fraction)" ;
		cpmeta:hasQuantityKind <http://meta.icos-cp.eu/resources/cpmeta/portion> ;
		cpmeta:hasUnit "nmol mol-1" .

	<http://meta.icos-cp.eu/resources/cpmeta/portion>
		a cpmeta:QuantityKind ;
		rdfs:label "portion" .
}

